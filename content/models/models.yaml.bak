# Model catalog: single source of truth for reComputer AI Lab
# Type/secondary category drive Tab and Family grouping; edit this file to add/remove models.

defaults:
  devices:
    - id: jetson-orin
      label: Jetson Orin
    - id: jetson-nano
      label: Jetson Orin Nano
    - id: rk3588
      label: RK3588
    - id: recomputer-j401
      label: reComputer J401
    - id: recomputer-r01
      label: reComputer R01
  engines:
    - id: vllm
      label: VLLM
    - id: ollama
      label: Ollama
    - id: tensorrt
      label: TensorRT-LLM

models:
  # --- CV: YOLO ---
  - id: yolo11n
    name: YOLO 11n
    slug: yolo11n
    overview: YOLO11 目标检测系列 nano 版本，轻量高效，适合边缘部署。测试用模型。
    type: cv
    secondaryCategoryId: yolo
    secondaryCategoryName: YOLO
    featured: true
    isNew: true
    updatedAt: "2025-01-15"
    downloads: 1200
    favorites: 320
    size: "~6MB"
    ram: "1GB+"
    precision: FP16
    restApiEndpoint: "POST http://localhost:8080/v1/detection"
    restApiExample: 'curl -X POST "http://localhost:8080/v1/detection" -H "Content-Type: application/json" -d ''{"image_url": "https://example.com/image.jpg", "conf": 0.25}'''
    restApiResponseExample: '{"success": true, "predictions": [{"class": "person", "confidence": 0.92}]}'
    curlExample: |
      curl -X POST "http://localhost:8080/v1/detection" \
        -H "Content-Type: application/json" \
        -d '{"image_url": "https://example.com/image.jpg", "conf": 0.25}'
    pythonExample: |
      import requests
      resp = requests.post(
          "http://localhost:8080/v1/detection",
          json={"image_url": "https://example.com/image.jpg", "conf": 0.25},
      )
      print(resp.json())
    devices:
      - id: recomputer-j401
        label: reComputer J401
      - id: rk3588
        label: reComputer RK3588
      - id: recomputer-r01
        label: reComputer R01
    engines:
      - id: vllm
        label: VLLM
      - id: tensorrt
        label: TensorRT-LLM
    docker:
      - deviceId: recomputer-j401
        engineId: vllm
        command: |
          sudo docker run -it --rm --pull always --runtime=nvidia \
            --network host ghcr.io/seeed-studio/vllm:latest-jetson-orin \
            vllm serve yolo11n
      - deviceId: rk3588
        engineId: vllm
        command: |
          sudo docker run -it --rm --pull always --runtime=nvidia \
            --network host ghcr.io/seeed-studio/vllm:latest-rk3588 \
            vllm serve yolo11n
      - deviceId: recomputer-r01
        engineId: vllm
        command: |
          sudo docker run -it --rm --pull always --runtime=nvidia \
            --network host ghcr.io/seeed-studio/vllm:latest-rk3588 \
            vllm serve yolo11n
    benchmarks:
      - device: reComputer J401
        value: 55
        unit: FPS
      - device: reComputer RK3588
        value: 42
        unit: FPS
      - device: reComputer R01
        value: 35
        unit: FPS
    wiki: |
      ## 概述
      YOLO 11n 是 YOLO11 目标检测系列的 nano 版本，参数量最小，适合在 reComputer 等边缘设备上实时运行。
      支持常见 COCO 类别检测，可通过 REST API 或 Python SDK 调用。
      部署后可通过 HTTP 上传图片或 URL 获取检测结果（边界框与置信度）。

  - id: yolo11s
    name: yolo11s
    slug: yolo11s
    overview: YOLO11 small，精度与速度平衡。
    type: cv
    secondaryCategoryId: yolo
    secondaryCategoryName: YOLO
