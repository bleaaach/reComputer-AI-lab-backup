{
  "name": "recomputer-ai-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:models": "node scripts/build-models.js",
    "prebuild": "npm run build:models",
    "dev": "WATCHPACK_POLLING=true chokidar 'content/**/*.{yaml,yml,md}' -c 'npm run build:models' & next dev -p 3004",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/.next && rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public",
    "start": "cross-env PORT=3004 node .next/standalone/server.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/space-grotesk": "^5.2.10",
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify/react": "^6.0.2",
    "js-yaml": "^4.1.1",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^2.12.0",
    "rehype-raw": "^7.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.0",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
